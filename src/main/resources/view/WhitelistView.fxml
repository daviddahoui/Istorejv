<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.istorejv.controller.WhitelistController"
            prefWidth="960" prefHeight="640">
    <top>
        <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
            <Label text="Liste blanche" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour aux utilisateurs" onAction="#handleBackToUsers"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>
            <Label text="Seuls ces e-mails peuvent créer un compte depuis l'écran de connexion." styleClass="muted"/>
            <HBox spacing="10">
                <TextField fx:id="emailField" promptText="E-mail à autoriser" HBox.hgrow="ALWAYS" onAction="#handleAddEmail"/>
                <Button text="Autoriser" onAction="#handleAddEmail" styleClass="button-primary"/>
                <Button text="Retirer la sélection" onAction="#handleRemoveEmail" styleClass="button-danger"/>
            </HBox>
            <ListView fx:id="whitelistListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
