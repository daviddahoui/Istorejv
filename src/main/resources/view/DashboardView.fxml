<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.istorejv.controller.DashboardController"
            prefWidth="960" prefHeight="640">
    <top>
        <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
            <Label text="iStore" styleClass="brand"/>
            <Label fx:id="welcomeLabel" text="Bienvenue" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Déconnexion" onAction="#handleLogoutAction"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            <Label text="Tableau de bord" styleClass="title"/>
            <HBox spacing="14">
                <Button text="Magasins" onAction="#handleStoreManagementAction" styleClass="nav-tile"/>
                <Button text="Inventaire" onAction="#handleInventoryManagementAction" styleClass="nav-tile"/>
                <Button fx:id="userManagementButton" text="Utilisateurs" onAction="#handleUserManagementAction" styleClass="nav-tile" visible="false" managed="${userManagementButton.visible}"/>
            </HBox>
            <ListView fx:id="storeEmployeesListView" VBox.vgrow="ALWAYS" visible="false"/>
        </VBox>
    </center>
</BorderPane>
