<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.istorejv.controller.StoreManagementController"
            prefWidth="960" prefHeight="640">
    <top>
        <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
            <Label text="Magasins" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour au tableau de bord" onAction="#handleBackToDashboardAction"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>
            <HBox fx:id="adminActions" spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="storeNameField" promptText="Nom du nouveau magasin" HBox.hgrow="ALWAYS"/>
                <Button text="Créer le magasin" onAction="#handleCreateStoreAction" styleClass="button-primary"/>
                <Button text="Supprimer la sélection" onAction="#handleDeleteStoreAction" styleClass="button-danger"/>
            </HBox>
            <Label fx:id="readOnlyLabel" text="Consultation seule : la gestion des magasins est réservée aux administrateurs." styleClass="muted"/>
            <ListView fx:id="storeListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
